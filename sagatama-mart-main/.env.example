# .env.example — Sagatama Mart / SGT backend
#
# Copy file ini jadi ".env" (JANGAN commit .env yang asli ke GitHub —
# pastikan ".env" sudah masuk .gitignore), lalu isi nilainya masing-masing.
#
# Dipakai oleh: firebase-init.js, api/sgt/*, api/payments/*,
#               scripts/migrate-sgt-wallets.js, scripts/verify-sgt-migration.js

# ── Pi Network Server API Key ──────────────────────────────────────────
# Ambil dari https://developers.minepi.com → App kamu → Server API Key
# (BUKAN App ID). Dipakai di api/payments/complete.js & cancel.js untuk
# approve/complete pembayaran Pi server-to-server.
PI_API_KEY=

# ── CORS ────────────────────────────────────────────────────────────────
# Domain frontend yang boleh akses API ini, contoh: https://sagatama-mart.vercel.app
# Boleh dikosongkan saat development (akan fallback ke "*").
ALLOWED_ORIGIN=

# ── Firebase: project portal-sagatama (Mart + Games + sgt_wallets) ─────
# CARA PALING AMAN (disarankan): download service account JSON dari
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key, simpan filenya LOKAL (jangan commit ke GitHub), lalu isi
# path-nya di sini:
FIREBASE_SERVICE_ACCOUNT_JSON=./portal-sagatama-key.json

# ALTERNATIF (kalau tidak pakai file JSON di atas) — isi 3 variabel ini
# manual. HATI-HATI: sering rusak kalau di-copy-paste lewat Notepad di
# Windows karena karakter \n di private key bisa berubah jadi baris baru
# sungguhan. Lebih aman pakai FIREBASE_SERVICE_ACCOUNT_JSON di atas.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ALTERNATIF LAIN yang dipakai firebase-init.js di production (Vercel):
# seluruh isi file JSON service account di-base64-kan jadi satu baris.
# FIREBASE_SERVICE_ACCOUNT_B64=

# ── Firebase: project hidayatulamin-e6f22 (project TERPISAH) ───────────
# Opsional — hanya perlu diisi kalau mau ikut memverifikasi/memigrasi
# sumber saldo dari Hidayatulamin. Generate service account key-nya dari
# Firebase Console project hidayatulamin-e6f22 sendiri (bukan yang di atas).
HIDAYATULAMIN_SERVICE_ACCOUNT_JSON=./hidayatulamin-key.json
# ALTERNATIF manual (sama catatan seperti di atas soal \n):
# HIDAYATULAMIN_PROJECT_ID=
# HIDAYATULAMIN_CLIENT_EMAIL=
# HIDAYATULAMIN_PRIVATE_KEY=

# ── Secret internal untuk komunikasi server-to-server antar app ────────
# Dipakai supaya Games & Hidayatulamin bisa memanggil endpoint
# credit/debit/transfer di api/sgt/* tanpa perlu accessToken user.
# WAJIB sama persis nilainya di KETIGA project Vercel (Mart, Games,
# Hidayatulamin). Generate sekali dengan:
#   openssl rand -hex 32
SGT_INTERNAL_SECRET=
