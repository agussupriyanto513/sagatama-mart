{
  "version": 2,
  "functions": {
    "api/payments/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/payments/(.*)",
      "dest": "/api/payments/$1.js"
    },
    {
      "src": "/validation-key.txt",
      "dest": "/public/validation-key.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
