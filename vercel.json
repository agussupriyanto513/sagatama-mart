{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/payments/(.*)",
      "dest": "/api/payments/$1.js"
    },
    {
      "src": "/api/orders/(.*)",
      "dest": "/api/orders/$1.js"
    },
    {
      "src": "/api/sgt/(.*)",
      "dest": "/api/sgt/$1.js"
    },
    {
      "src": "/validation-key.txt",
      "dest": "/public/validation-key.txt"
    },
    {
      "src": "/logo-sagatama.png",
      "dest": "/public/logo-sagatama.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}